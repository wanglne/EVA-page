---
import results from "../data/results.json";

const modelIds = ["internvl", "qwen-vl", "llava"] as const;
const scenarios = ["SD", "TYPO", "SD+TYPO"];
const utilityBenchmarks = ["MM-Vet-v2", "MMMU", "MMStar"];
const models = modelIds.map((id) => {
  const safety = results.safety.vlm[id];
  const utility = results.utility.vlm[id];
  return {
    id,
    name: results.models.vlm.find((model) => model.id === id)!.name,
    beforeSafety: safety
      .find((row) => row.method === "Vanilla")!
      .values.slice(12, 15),
    afterSafety: safety
      .find((row) => row.method === "EVA")!
      .values.slice(12, 15),
    beforeUtility: utility.find((row) => row.method === "Vanilla")!.values,
    afterUtility: utility.find((row) => row.method === "EVA")!.values,
  };
});
const percent = (raw: string) => (Number(raw) * 100).toFixed(0);
---

<div class="impact-comparison" aria-labelledby="impact-comparison-title">
  <div class="impact-comparison-header">
    <h3 id="impact-comparison-title">Before and after EVA</h3>
    <label>
      <span class="sr-only">Comparison model</span>
      <select
        id="impact-model"
        aria-label="Comparison model"
        aria-controls="impact-comparison-results"
      >
        {models.map((model) => <option value={model.id}>{model.name}</option>)}
      </select>
    </label>
  </div>
  <div
    id="impact-comparison-results"
    class="impact-comparison-body"
    aria-live="polite"
  >
    {
      models.map((model, modelIndex) => (
        <table data-impact-model={model.id} hidden={modelIndex !== 0}>
          <caption class="sr-only">
            {model.name}: safety and general utility before and after EVA.
          </caption>
          <colgroup>
            <col class="impact-metric-column" />
            <col class="impact-value-column" />
            <col class="impact-value-column" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col">Before</th>
              <th scope="col" class="impact-after-label">
                After EVA
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="impact-metric-group">
              <th colspan="3" scope="colgroup">
                MM-SafetyBench · ASR (%) ↓
              </th>
            </tr>
            {scenarios.map((scenario, index) => (
              <tr class="impact-safety-row">
                <th scope="row">
                  <div class="impact-metric-pair">
                    <span>{scenario}</span>
                    <div class="impact-bar-track" aria-hidden="true">
                      <span
                        class="impact-bar-before"
                        style={`width: ${percent(model.beforeSafety[index].raw)}%`}
                      />
                      <span
                        class="impact-bar-after"
                        style={`width: ${percent(model.afterSafety[index].raw)}%`}
                      />
                    </div>
                  </div>
                </th>
                <td class="impact-before-value">
                  {percent(model.beforeSafety[index].raw)}
                </td>
                <td class="impact-after-value">
                  {percent(model.afterSafety[index].raw)}
                </td>
              </tr>
            ))}
          </tbody>
          <tbody class="impact-utility-group">
            <tr class="impact-metric-group">
              <th colspan="3" scope="colgroup">
                General utility · Score ↑
              </th>
            </tr>
            {utilityBenchmarks.map((benchmark, index) => (
              <tr class="impact-utility-row">
                <th scope="row">{benchmark}</th>
                <td class="impact-before-value">
                  {model.beforeUtility[index].value}
                </td>
                <td class="impact-utility-value">
                  {model.afterUtility[index].value}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ))
    }
  </div>
  <p class="impact-comparison-note">
    <a
      href="https://arxiv.org/pdf/2605.14750#page=8"
      target="_blank"
      rel="noopener noreferrer">Tables 3 &amp; 5</a
    >
    · SD: harmful images generated by Stable Diffusion; TYPO: harmful text in images
    (OCR attacks); SD+TYPO: combines both.
  </p>
</div>

<script>
  const comparisonModel =
    document.querySelector<HTMLSelectElement>("#impact-model");
  const comparisonTables = document.querySelectorAll<HTMLTableElement>(
    "[data-impact-model]",
  );
  comparisonModel?.addEventListener("change", () => {
    comparisonTables.forEach((table) => {
      table.hidden = table.dataset.impactModel !== comparisonModel.value;
    });
  });
</script>
